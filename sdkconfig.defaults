# ESP32-WROVER-E: 16 MB flash, 8 MB PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y

# lwIP: IP forwarding and NAPT (required for PPP → SoftAP routing)
# LWIP_NAPT_TMOUT / LWIP_NAPT_TMOUT_UDP are C-level macros, not Kconfig symbols.
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# WiFi RX buffers
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# Watchdog timeout — modem boot can take several seconds
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
